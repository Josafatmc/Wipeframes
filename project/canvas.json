    "t0": {"x": 0, "y": -300, "text": "Mapa del sitio, recorridos y roles", "kind": "title1", "maxW": 1600},
    "t1": {"x": 0, "y": 2320, "text": "Sitio público · Recorrido de captación (visitante)", "kind": "title1", "maxW": 8080},
    "t2": {"x": 0, "y": 5420, "text": "Acceso, centro de atención y páginas secundarias", "kind": "title1", "maxW": 9440},
